NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0
FRONTEND_ORIGIN=http://localhost:5173

# Server-only PostgreSQL/Supabase database connection strings.
DATABASE_URL=postgresql://geopulse_api:your-password@db.your-project.supabase.co:5432/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://geopulse_api:your-password@db.your-project.supabase.co:5432/postgres?sslmode=require

# Supabase Auth token verification uses the public anon/publishable key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
ATTENDANCE_PHOTO_BUCKET=attendance-photos

MAX_GPS_ACCURACY_METERS=20
ATTENDANCE_TIME_ZONE=Asia/Jakarta